[Unit]
Description=NoxalAi local assistant (inference runs as a child process)
PartOf=flowde.target
After=dbus.socket

[Service]
Type=simple
ExecStart=/usr/bin/noxal-ai
Restart=on-failure
RestartSec=1
RestartSteps=5
RestartMaxDelaySec=30
MemoryMax=3G
TasksMax=64
CPUWeight=50
Nice=5
# Sandboxing: no root, no new privileges, read-only system, writable only own state.
Environment=MALLOC_ARENA_MAX=1 MALLOC_MMAP_THRESHOLD_=131072 MALLOC_TRIM_THRESHOLD_=131072
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%S/flowde %t/flowde -%h/.config/flowde
StateDirectory=flowde
RuntimeDirectory=flowde
RuntimeDirectoryPreserve=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
# Spawns other programs: no MemoryDenyWriteExecute / syscall filter here, children inherit.

[Install]
WantedBy=flowde.target
