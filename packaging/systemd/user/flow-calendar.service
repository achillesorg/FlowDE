[Unit]
Description=FlowDE calendar store
PartOf=flowde.target
After=dbus.socket

[Service]
Type=simple
ExecStart=/usr/bin/flow-calendar
Restart=on-failure
RestartSec=1
RestartSteps=5
RestartMaxDelaySec=30
MemoryMax=24M
TasksMax=64
CPUWeight=50
Nice=5
# Sandboxing: no root, no new privileges, read-only system, writable only own state.
Environment=MALLOC_ARENA_MAX=1 MALLOC_MMAP_THRESHOLD_=131072 MALLOC_TRIM_THRESHOLD_=131072
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%S/flowde %t/flowde -%h/.config/flowde
StateDirectory=flowde
RuntimeDirectory=flowde
RuntimeDirectoryPreserve=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=flowde.target
